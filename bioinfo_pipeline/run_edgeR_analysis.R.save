nano run_edgeR_analysis.Rv Rscript

# ===========================
# edgeR Differential Expression Analysis
# ===========================

suppressPackageStartupMessages({
  library(edgeR)
  library(dplyr)
  library(openxlsx)
  library(ggplot2)
})

set.seed(0)

args <- commandArgs(trailingOnly = TRUE)
if(length(args)<2) stop("Usage: Rscript run_edgeR_analysis.R <count_file> <sampleinfo_file>")

count_file <- args[1]
sampleinfo_file <- args[2]

LOG2FC_THRESHOLD <- 1
FDR_THRESHOLD <- 0.05

# ===========================
filename <- tools::file_path_sans_ext(basename(count_file))
output_dir <- file.path("results/DEG", filename)
dir.create(output_dir, showWarnings=FALSE, recursive=TRUE)

counts <- read.csv(count_file, row.names=1, check.names=FALSE)
sampleinfo <- read.delim(sampleinfo_file, sep="\t")
colnames(sampleinfo) <- trimws(colnames(sampleinfo))
sampleinfo$Sample <- trimws(sampleinfo$Sample)
sampleinfo$Condition <- trimws(sampleinfo$Condition)

count_cols_clean <- gsub("\\.bam$|_Aligned.*$|\\.fastq.*$|\\.htseq.*$", "", colnames(counts))
sampleinfo$CleanName <- gsub("\\.bam$|_Aligned.*$|\\.fastq.*$|\\.htseq.*$", "", sampleinfo$Sample)
matching <- intersect(count_cols_clean, sampleinfo$CleanName)
if(length(matching)==0) stop("No matching samples found!")
count_idx <- match(sampleinfo$CleanName, count_cols_clean)
valid_idx <- !is.na(count_idx)
count_matrix <- round(as.matrix(counts[, count_idx[valid_idx]]))
sampleinfo_matched <- sampleinfo[valid_idx, ]

# ===========================
# Filter housekeeping / non-zero
count_matrix <- count_matrix[rowSums(count_matrix) > 0, ]

group <- factor(sampleinfo_matched$Condition)
y <- DGEList(counts=count_matrix, group=group)
keep <- filterByExpr(y)
y <- y[keep, , keep.lib.sizes=FALSE]
y <- calcNormFactors(y)

design <- model.matrix(~group)
y <- estimateDisp(y, design)
fit <- glmQLFit(y, design)

# ===========================
# Normalized CPM
norm_cpm <- cpm(y, normalized.lib.sizes=TRUE)
write.xlsx(data.frame(Gene=rownames(norm_cpm), norm_cpm), file.path(output_dir,paste0(filename,"_edgeR_Normalized_CPM.xlsx")), rowNames=FALSE)

# ===========================
# PCA plot
pca <- prcomp(t(norm_cpm))
var_pct <- round(100*(pca$sdev^2)/sum(pca$sdev^2),2)
scores <- data.frame(pca$x, Condition=group)
write.xlsx(scores, file.path(output_dir,paste0(filename,"_edgeR_PCA_Scores.xlsx")), rowNames=FALSE)

p <- ggplot(scores, aes(PC1, PC2, color=Condition, label=rownames(scores))) +
  geom_point(size=4) + geom_text(vjust=-0.8, hjust=0.5, size=3, show.legend=FALSE) +
  labs(x=paste0("PC1 (",var_pct[1],"%)"), y=paste0("PC2 (",var_pct[2],"%)"),
       title=paste("edgeR PCA -",filename)) +
  theme_bw() + theme(plot.title=element_text(hjust=0.5, face="bold", size=14))
ggsave(file.path(output_dir,paste0(filename,"_edgeR_PCA_Plot.png")), p, width=10, height=8, dpi=300)

# ===========================
# Pairwise DE
results_summary <- data.frame(Comparison=character(), UP=numeric(), DOWN=numeric(), Total_DEGs=numeric())
conditions <- levels(group)

for(i in 1:(length(conditions)-1)){
  for(j in (i+1):length(conditions)){
    c1 <- conditions[i]; c2 <- conditions[j]; comp <- paste0(c1,"_vs_",c2)
    contrast <- makeContrasts(contrasts=paste0(c2,"-",c1), levels=design)
    qlf <- glmQLFTest(fit, contrast=contrast)
    res <- topTags(qlf, n=Inf)$table
    if(nrow(res)==0) next
    res$Gene <- rownames(res)
    
    # Volcano
    res$Status <- "NS"
    res$Status[res$FDR<FDR_THRESHOLD & res$logFC>LOG2FC_THRESHOLD] <- "UP"
    res$Status[res$FDR<FDR_THRESHOLD & res$logFC< -LOG2FC_THRESHOLD] <- "DOWN"
    
    png(file.path(output_dir,paste0(filename,"_",comp,"_edgeR_Volcano.png")), width=3400, height=3400, res=600)
    print(
      ggplot(res, aes(logFC, -log10(FDR), color=Status)) +
        geom_point(alpha=0.6, size=2) +
        geom_vline(xintercept=c(-LOG2FC_THRESHOLD,LOG2FC_THRESHOLD), linetype="dashed") +
        geom_hline(yintercept=-log10(FDR_THRESHOLD), linetype="dashed") +
        scale_color_manual(values=c(UP="red", DOWN="blue", NS="grey")) +
        theme_bw() +
        labs(title=paste("Volcano:",filename,"-",comp))
    )
    dev.off()
    
    # Save UP/DOWN
    UP <- res[res$Status=="UP",]; DOWN <- res[res$Status=="DOWN",]
    if(nrow(UP)>0) write.xlsx(UP, file.path(output_dir,paste0(filename,"_",comp,"_edgeR_UP.xlsx")), rowNames=FALSE)
    if(nrow(DOWN)>0) write.xlsx(DOWN, file.path(output_dir,paste0(filename,"_",comp,"_edgeR_DOWN.xlsx")), rowNames=FALSE)
    
    results_summary <- rbind(results_summary, data.frame(Comparison=comp, UP=nrow(UP), DOWN=nrow(DOWN), Total_DEGs=nrow(res[res$FDR<FDR_THRESHOLD,])))
  }
}

write.xlsx(results_summary, file.path(output_dir,paste0(filename,"_edgeR_DEG_Summary.xlsx")), rowNames=FALSE)
cat("edgeR Analysis complete! Output in:", output_dir,"\n")
